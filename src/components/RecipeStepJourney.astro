---
// Ścieżka kroków gotowania: poziomy nawigator etapów nad listą kart.
// Dokładnie jeden etap jest początkowo rozwinięty — pokazuje przypisane półkroki
// (z własnym nagłówkiem „Przygotuj przed wykonaniem”), finalny krok i akcję oznaczenia go jako
// zrobiony. Pozostałe etapy pozostają zwiniętym, jednoliniowym zapowiedzeniem.
// Komponent renderuje jedną wersję kroków; strona przepisu osadza go osobno dla
// „Trybu asystenta” (z półkrokami) i dla „Tylko kroki”.
import type { PreparationStep } from '@/domain/recipe';
import { formatMessage } from '@/i18n/format';
import type { AppMessages } from '@/i18n/messages';
import './RecipeStepJourney.css';

interface Props {
  mode: 'assistant' | 'steps';
  steps: readonly string[];
  preparation?: readonly PreparationStep[];
  messages: AppMessages['recipe'];
  class?: string;
}

const { mode, steps, preparation = [], messages, class: className } = Astro.props;

const cards = steps.map((text, index) => {
  const number = index + 1;
  return {
    number,
    text,
    bodyId: `step-${mode}-${number}-body`,
    label: formatMessage(messages.stepLabel, { number }),
    preparation: preparation.filter((item) => item.beforeStep === number),
  };
});
---

<div class:list={['step-journey', className]} data-step-journey={mode}>
  <ol
    class="step-journey__navigator"
    aria-label={messages.stepsHeading}
    data-step-navigator
    hidden
  >
    {cards.map((card) => (
      <li>
        <button
          type="button"
          class="step-journey__marker"
          data-step-marker
          data-step-number={card.number}
          aria-label={card.label}
          aria-controls={card.bodyId}
        >
          <span data-step-badge aria-hidden="true">{card.number}</span>
        </button>
      </li>
    ))}
  </ol>

  <ol class="step-list" data-step-list={mode}>
    {cards.map((card) => (
      <li
        class="step-item"
        data-step-item
        data-step-number={card.number}
      >
        <div class="step-item__card">
          <h3 class="step-item__heading">
            <button
              type="button"
              class="step-item__head"
              data-step-head
              aria-expanded="true"
              aria-controls={card.bodyId}
              hidden
            >
              <span class="visually-hidden">{card.label}</span>
              <span class="step-item__label" aria-hidden="true">
                {formatMessage(messages.stepCardLabel, { number: card.number })}
              </span>
              <span class="step-item__preview">{card.text}</span>
              <svg class="step-item__chevron" viewBox="0 0 20 20" aria-hidden="true">
                <path d="m5 12 5-5 5 5" />
              </svg>
            </button>
            <span class="step-item__heading-fallback visually-hidden">{card.label}</span>
          </h3>

          <div class="step-item__body" id={card.bodyId} data-step-body>
            {card.preparation.length > 0 && (
              <div class="step-prep" data-step-prep hidden>
                <p class="step-item__prep-title">{messages.stepPreparationHeading}</p>
                <ul class="step-prep__list">
                  {card.preparation.map((item) => (
                    <li
                      class="step-prep__item"
                      data-preparation-half-step={item.id}
                      data-before-step={item.beforeStep}
                    >
                      <button
                        type="button"
                        class="step-prep__toggle"
                        data-preparation-toggle
                        data-preparation-id={item.id}
                        aria-pressed="false"
                        aria-label={formatMessage(messages.checkPreparationLabel, {
                          name: item.stepText,
                        })}
                        data-check-label={formatMessage(messages.checkPreparationLabel, {
                          name: item.stepText,
                        })}
                        data-uncheck-label={formatMessage(messages.uncheckPreparationLabel, {
                          name: item.stepText,
                        })}
                      >
                        <span class="step-prep__box" aria-hidden="true"></span>
                        <span class="step-prep__text">{item.stepText}</span>
                      </button>
                    </li>
                  ))}
                </ul>
                <p class="step-progress" data-step-group-progress>
                  <span class="step-progress__track" aria-hidden="true">
                    <span class="step-progress__fill"></span>
                  </span>
                  <span data-step-group-progress-text></span>
                </p>
              </div>
            )}

            <div class="step-final">
              <div class="step-final__content">
                {card.preparation.length > 0 && (
                  <p class="step-final__label" data-step-final-label hidden>
                    {messages.stepFinalLabel}
                  </p>
                )}
                <p class="step-final__text">{card.text}</p>
              </div>
              <button
                type="button"
                class="step-final__action"
                data-checkable-step
                data-step-number={card.number}
                data-check-label={messages.finishStepAction}
                data-uncheck-label={messages.finishedStepAction}
                aria-pressed="false"
                hidden
              >
                <span class="step-final__action-mark" aria-hidden="true">✓</span>
                <span class="step-final__action-label" data-step-action-label>
                  {messages.finishStepAction}
                </span>
                <span class="visually-hidden">{card.label}</span>
              </button>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <p
    class="step-list-completion"
    data-step-list-completion={mode}
    aria-live="polite"
    hidden
  >
    {messages.stepsCompleteMessage}
  </p>
</div>
