---
import RecipeStepJourney from '@/components/RecipeStepJourney.astro';
import { getPublishedRecipes } from '@/data/recipes';
import { preparationTimings, type Recipe } from '@/domain/recipe';
import { formatMeasure } from '@/domain/ingredient';
import { ingredientCategories } from '@/domain/ingredient-category';
import { defaultLocale } from '@/i18n/config';
import { formatMessage } from '@/i18n/format';
import { getMessages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import './recipe-page.css';

export async function getStaticPaths() {
  const recipes = await getPublishedRecipes();
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
const messages = getMessages(defaultLocale);
const hasAssistantContent = Boolean(recipe.preparation);
const ingredientProgress = formatMessage(messages.recipe.ingredientsProgress, {
  checked: 0,
  total: recipe.ingredients.length,
});
const ingredientGroups = ingredientCategories.flatMap((category) => {
  const ingredients = recipe.ingredients.filter(
    (ingredient) => ingredient.category === category,
  );
  return ingredients.length > 0 ? [{ category, ingredients }] : [];
});
const preparationGroups = preparationTimings.flatMap((timing) => {
  const items = recipe.preparation?.filter((item) => item.timing === timing) ?? [];
  return items.length > 0 ? [{ timing, items }] : [];
});
---

<BaseLayout
  title={`${recipe.title} — ${messages.common.brand}`}
  description={recipe.description}
  locale={defaultLocale}
>
  <main class="recipe-page">
    <article
      class="recipe-article"
      data-progress-template={messages.recipe.ingredientsProgress}
      data-progress-complete={messages.recipe.ingredientsProgressComplete}
      data-step-progress-template={messages.recipe.stepProgress}
      data-step-progress-complete={messages.recipe.stepProgressComplete}
      data-steps-journey-template={messages.recipe.stepsJourneyProgress}
      data-base-servings={recipe.servings}
    >
      <header class="recipe-hero">
        <div class="recipe-hero__media">
          <span class="recipe-hero__placeholder recipe-placeholder" aria-hidden="true">O</span>
          {
            recipe.image && (
              <img
                class="recipe-hero__image"
                src={recipe.image.src}
                alt={recipe.image.alt}
                loading="eager"
                fetchpriority="high"
              />
            )
          }
        </div>
        <div class="recipe-hero__shade" aria-hidden="true"></div>
        <a
          class="recipe-back"
          href="/"
          aria-label={messages.recipe.backLabel}
          data-recipe-back
        >
          <span class="recipe-back__surface">
            <svg class="recipe-back__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
            {messages.recipe.backShort}
          </span>
        </a>
        <div class="recipe-hero__caption">
          <h1>{recipe.title}</h1>
          <ul class="recipe-tags" aria-label={messages.common.tagsLabel}>
            {recipe.tags.map((tag, index) => (
              <li>
                {index > 0 && <span class="recipe-tags__separator" aria-hidden="true"></span>}
                {tag}
              </li>
            ))}
          </ul>
        </div>
      </header>

      <div class="recipe-summary">
        <div class="recipe-meta" aria-label={`${messages.recipe.difficultyLabel}, ${messages.recipe.servingsLabel}, ${messages.recipe.timeLabel}`}>
          <div class="recipe-meta__item">
            <span class="recipe-meta__label">{messages.recipe.difficultyLabel}</span>
            <strong>{messages.recipe.difficulty[recipe.difficulty]}</strong>
          </div>
          <div class="recipe-meta__item recipe-meta__item--servings">
            <span class="recipe-meta__label">{messages.recipe.servingsLabel}</span>
            <div class="servings-control">
              <button
                type="button"
                class="servings-control__button"
                data-servings-delta="-1"
                aria-label={messages.recipe.decreaseServingsLabel}
                hidden
              >
                <span class="servings-control__button-mark" aria-hidden="true">−</span>
              </button>
              <strong data-servings-output aria-live="polite">{recipe.servings}</strong>
              <button
                type="button"
                class="servings-control__button"
                data-servings-delta="1"
                aria-label={messages.recipe.increaseServingsLabel}
                hidden
              >
                <span class="servings-control__button-mark" aria-hidden="true">+</span>
              </button>
            </div>
          </div>
          <div class="recipe-meta__item">
            <span class="recipe-meta__label">{messages.recipe.timeLabel}</span>
            <strong>
              <span class="visually-hidden">{messages.recipe.preparationTimeLabel} </span>
              {recipe.preparationMinutes} {messages.common.minuteAbbreviation}
            </strong>
          </div>
        </div>
      </div>

      <div class="recipe-body">
        <section class="recipe-lead" aria-labelledby="description-heading">
          <div class="recipe-section-head recipe-section-head--stacked">
            <h2 id="description-heading">
              <button
                type="button"
                class="recipe-section-toggle"
                aria-expanded="true"
                aria-controls="description-content"
                data-section-toggle
                hidden
              >
                <span>{messages.recipe.descriptionHeading}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 12 5-5 5 5" /></svg>
              </button>
              <span class="recipe-section-title-fallback">{messages.recipe.descriptionHeading}</span>
            </h2>
          </div>
          <div id="description-content" data-section-content>
            <p>{recipe.description}</p>
          </div>
        </section>

        <section class="recipe-ingredients" aria-labelledby="ingredients-heading">
          <div class="recipe-section-head recipe-ingredients__head">
            <h2 id="ingredients-heading">
              <button
                type="button"
                class="recipe-section-toggle"
                aria-expanded="true"
                aria-controls="ingredients-content"
                data-section-toggle
                hidden
              >
                <span>{messages.recipe.ingredientsHeading}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 12 5-5 5 5" /></svg>
              </button>
              <span class="recipe-section-title-fallback">{messages.recipe.ingredientsHeading}</span>
            </h2>
            <p class="ingredient-progress" data-ingredient-progress aria-live="polite" hidden>
              <span class="ingredient-progress__dial" aria-hidden="true">
                <svg class="ingredient-progress__ring" viewBox="0 0 24 24">
                  <circle class="ingredient-progress__track" cx="12" cy="12" r="10"></circle>
                  <circle class="ingredient-progress__arc" cx="12" cy="12" r="10" pathLength="1"
                  ></circle>
                </svg>
                <span class="ingredient-progress__mark">✓</span>
              </span>
              <span class="ingredient-progress__text" data-ingredient-progress-text>
                {ingredientProgress}
              </span>
            </p>
          </div>

          <div class="ingredient-groups" id="ingredients-content" data-section-content>
            {ingredientGroups.map(({ category, ingredients }) => (
              <section class="ingredient-group">
                <h3>{messages.recipe.ingredientCategories[category]}</h3>
                <ul class="ingredient-list">
                  {ingredients.map((ingredient) => (
                    <li
                      class="ingredient"
                      data-base-amount={ingredient.amount}
                      data-unit={ingredient.unit}
                      data-grams-per-cup={ingredient.gramsPerCup}
                      data-household-unit={ingredient.household?.unit}
                      data-household-metric-amount={ingredient.household?.metricAmount}
                      data-measure={ingredient.measure}
                    >
                      <button
                        type="button"
                        class="ingredient__toggle"
                        data-checkable-ingredient
                        aria-pressed="false"
                        aria-label={formatMessage(messages.recipe.checkIngredientLabel, {
                          name: ingredient.name,
                        })}
                        data-check-label={formatMessage(messages.recipe.checkIngredientLabel, {
                          name: ingredient.name,
                        })}
                        data-uncheck-label={formatMessage(messages.recipe.uncheckIngredientLabel, {
                          name: ingredient.name,
                        })}
                        hidden
                      >
                        <span class="ingredient__box" aria-hidden="true"></span>
                        <span class="ingredient__name">{ingredient.name}</span>
                        <span class="ingredient__measure" data-ingredient-measure>
                          {formatMeasure(ingredient)}
                        </span>
                      </button>
                      <span class="ingredient__fallback">
                        <span>{ingredient.name}</span>
                        <span class="ingredient__measure">{formatMeasure(ingredient)}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </section>

        <div class="recipe-cooking-flow">
          {
            hasAssistantContent && (
              <section class="assistant-choice" aria-labelledby="assistant-choice-heading" data-assistant-choice hidden>
              <div class="recipe-section-head recipe-section-head--stacked">
                <h2 id="assistant-choice-heading">
                  <button
                type="button"
                class="recipe-section-toggle"
                aria-expanded="true"
                aria-controls="cooking-flow-content"
                data-section-toggle
                hidden
                  >
                    <span>{messages.recipe.assistantChoiceHeading}</span>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 12 5-5 5 5" /></svg>
                  </button>
                  <span class="recipe-section-title-fallback">{messages.recipe.assistantChoiceHeading}</span>
                </h2>
              </div>
              </section>
            )
          }

          <div id="cooking-flow-content" class="recipe-cooking-flow__content recipe-section-content" data-section-content>
            {
              hasAssistantContent && (
              <div class="assistant-choice__controls">
                <p class="assistant-choice__hint">{messages.recipe.assistantChoiceHint}</p>
                <div
                  class="assistant-toggle recipe-segmented"
                  role="group"
                  aria-label={messages.recipe.assistantLabel}
                >
                  <button
                    type="button"
                    class="recipe-segmented__option"
                    data-view-target="assistant"
                    aria-pressed="false"
                  >
                    {messages.recipe.assistantMode}
                  </button>
                  <button
                    type="button"
                    class="recipe-segmented__option"
                    data-view-target="steps"
                    aria-pressed="false"
                  >
                    {messages.recipe.stepsOnlyMode}
                  </button>
                </div>
              </div>
              )
            }

          {
            recipe.preparation && (
              <section class="recipe-prep assistant-section recipe-mode-content" aria-labelledby="prep-heading">
              <div class="recipe-section-head recipe-section-head--stacked">
                <p class="recipe-stage-label">{messages.recipe.preparationStageLabel}</p>
                <h2 id="prep-heading">
                  <button
                    type="button"
                    class="recipe-section-toggle"
                    aria-expanded="true"
                    aria-controls="preparation-content"
                    data-section-toggle
                    hidden
                  >
                    <span>{messages.recipe.preparationHeading}</span>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 12 5-5 5 5" /></svg>
                  </button>
                  <span class="recipe-section-title-fallback">{messages.recipe.preparationHeading}</span>
                </h2>
              </div>
              <div id="preparation-content" class="recipe-section-content" data-section-content>
                <p class="recipe-prep__hint">{messages.recipe.preparationHint}</p>
                <div class="prep-groups">
                  {preparationGroups.map(({ timing, items }) => (
                    <section class="prep-group" aria-labelledby={`prep-${timing}-heading`}>
                    <h3 id={`prep-${timing}-heading`}>
                      {messages.recipe.preparationTiming[timing]}
                    </h3>
                    <ul class="prep-list">
                      {items.map((item) => (
                        <li class="prep-list__item">
                          <button
                            type="button"
                            class="prep-list__toggle"
                            data-preparation-toggle
                            data-preparation-id={item.id}
                            aria-pressed="false"
                            aria-label={formatMessage(messages.recipe.checkPreparationLabel, {
                              name: item.text,
                            })}
                            data-check-label={formatMessage(messages.recipe.checkPreparationLabel, {
                              name: item.text,
                            })}
                            data-uncheck-label={formatMessage(messages.recipe.uncheckPreparationLabel, {
                              name: item.text,
                            })}
                            hidden
                          >
                            <span class="prep-list__box" aria-hidden="true"></span>
                            <span class="prep-list__text">{item.text}</span>
                          </button>
                          <span class="prep-list__fallback">
                            <span class="prep-list__mark" aria-hidden="true">✓</span>
                            <span>{item.text}</span>
                          </span>
                        </li>
                      ))}
                    </ul>
                    </section>
                  ))}
                </div>
              </div>
              </section>
            )
          }

          <section class="recipe-steps recipe-mode-content" aria-labelledby="steps-heading">
          <div class="recipe-section-head recipe-section-head--stacked">
            <p class="recipe-stage-label">{messages.recipe.stepsStageLabel}</p>
            <h2 id="steps-heading">
              <button
                type="button"
                class="recipe-section-toggle"
                aria-expanded="true"
                aria-controls="steps-content"
                data-section-toggle
                hidden
              >
                <span>{messages.recipe.stepsHeading}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 12 5-5 5 5" /></svg>
              </button>
              <span class="recipe-section-title-fallback">{messages.recipe.stepsHeading}</span>
            </h2>
          </div>
          <div id="steps-content" class="recipe-section-content" data-section-content>
          <RecipeStepJourney
            mode="assistant"
            steps={recipe.steps}
            preparation={recipe.preparation}
            messages={messages.recipe}
            class={recipe.stepsOnly ? 'assistant-section' : undefined}
          />
          {
            recipe.stepsOnly && (
              <RecipeStepJourney
                mode="steps"
                steps={recipe.stepsOnly}
                messages={messages.recipe}
                class="steps-only-section"
              />
            )
          }
          </div>
          </section>

          {
            recipe.tips && (
              <section class="recipe-tips recipe-mode-content" aria-labelledby="tips-heading">
              <h2 id="tips-heading">
                <button
                  type="button"
                  class="recipe-section-toggle"
                  aria-expanded="true"
                  aria-controls="tips-content"
                  data-section-toggle
                  hidden
                >
                  <span>{messages.recipe.tipsHeading}</span>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 12 5-5 5 5" /></svg>
                </button>
                <span class="recipe-section-title-fallback">{messages.recipe.tipsHeading}</span>
              </h2>
              <ul class="tips-list" id="tips-content" data-section-content>
                {recipe.tips.map((tip) => (
                  <li>
                    <span class="tips-list__mark" aria-hidden="true">✦</span>
                    <span>{tip}</span>
                  </li>
                ))}
              </ul>
              </section>
            )
          }
          </div>
        </div>

        <p class="prototype-note recipe-mode-content">{messages.recipe.prototypeNote}</p>
      </div>
    </article>
  </main>
</BaseLayout>

<script>
  import {
    formatMeasure,
    householdUnits,
    ingredientUnits,
    measureDisplays,
    type HouseholdUnit,
    type IngredientMeasure,
    type IngredientUnit,
    type MeasureDisplay,
  } from '@/domain/ingredient-measure';

  const article = document.querySelector<HTMLElement>('.recipe-article');
  const backLink = document.querySelector<HTMLAnchorElement>('[data-recipe-back]');
  backLink?.addEventListener('click', (event) => {
    if (
      event.button !== 0
      || event.metaKey
      || event.ctrlKey
      || event.shiftKey
      || event.altKey
      || window.history.length <= 1
      || !document.referrer
    ) {
      return;
    }

    event.preventDefault();
    window.history.back();
  });

  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const parseMotionDuration = (value: string | undefined) => {
    const token = value?.trim() ?? '';
    const amount = Number.parseFloat(token);
    if (!Number.isFinite(amount) || amount <= 0) return 0;
    return token.endsWith('ms') ? amount : amount * 1000;
  };
  const parsePixels = (value: string | undefined) => {
    const amount = Number.parseFloat(value ?? '');
    return Number.isFinite(amount) ? amount : 0;
  };

  const sectionToggles = Array.from(
    article?.querySelectorAll<HTMLButtonElement>('[data-section-toggle]') ?? [],
  );
  const sectionMotion = (() => {
    const sample = article?.querySelector<HTMLElement>('[data-section-content]');
    const styles = sample ? getComputedStyle(sample) : null;
    const duration = parseMotionDuration(styles?.getPropertyValue('--section-motion-duration'));
    const easing = styles?.getPropertyValue('--section-motion-easing').trim();
    return { duration: duration || 240, easing: easing || 'ease' };
  })();

  /* Zwijana treść zostaje w układzie przez cały ruch i dopiero na końcu znika,
     więc animować da się jedynie jej wysokość. Odstęp siatki nad treścią zniknie
     razem z nią, dlatego na czas ruchu przenosimy go do górnego paddingu treści
     (`row-gap` rodzica schodzi do zera) i animujemy razem z wysokością — inaczej
     układ przeskoczyłby o wysokość odstępu w chwili ukrycia. */
  const animateSection = (content: HTMLElement, nextExpanded: boolean) => {
    const parent = content.parentElement;
    const wasAnimating = content.classList.contains('is-animating');
    const wasHidden = content.hidden;
    const fromHeight = wasHidden ? 0 : content.getBoundingClientRect().height;
    const fromPadding = wasHidden ? 0 : parsePixels(getComputedStyle(content).paddingTop);

    for (const animation of content.getAnimations()) animation.cancel();
    content.classList.remove('is-animating');
    content.style.height = '';
    content.style.paddingTop = '';
    if (parent) parent.style.rowGap = '';
    content.hidden = false;

    const gap = parent ? parsePixels(getComputedStyle(parent).rowGap) : 0;
    const openHeight = content.getBoundingClientRect().height + gap;
    const openPadding = parsePixels(getComputedStyle(content).paddingTop) + gap;
    /* Przerwany ruch startuje z własnej, zmierzonej klatki; stan spoczynkowy
       dolicza do niej odstęp siatki, który zaraz przejmie padding treści. */
    const from = wasHidden || wasAnimating
      ? { height: fromHeight, paddingTop: fromPadding }
      : { height: openHeight, paddingTop: openPadding };
    const to = nextExpanded
      ? { height: openHeight, paddingTop: openPadding }
      : { height: 0, paddingTop: 0 };

    if (reducedMotionQuery.matches || Math.abs(to.height - from.height) < 1) {
      content.hidden = !nextExpanded;
      return;
    }

    content.classList.add('is-animating');
    if (parent) parent.style.rowGap = '0px';
    content.style.height = `${from.height}px`;
    content.style.paddingTop = `${from.paddingTop}px`;

    const animation = content.animate(
      [
        { height: `${from.height}px`, paddingTop: `${from.paddingTop}px` },
        { height: `${to.height}px`, paddingTop: `${to.paddingTop}px` },
      ],
      { duration: sectionMotion.duration, easing: sectionMotion.easing, fill: 'forwards' },
    );
    /* Wypełnienie do przodu utrzymuje ostatnią klatkę aż do przywrócenia
       własnego układu sekcji, więc między końcem ruchu a stanem docelowym nic
       nie mignie. */
    animation.addEventListener(
      'finish',
      () => {
        content.classList.remove('is-animating');
        animation.cancel();
        content.style.height = '';
        content.style.paddingTop = '';
        if (parent) parent.style.rowGap = '';
        content.hidden = !nextExpanded;
      },
      { once: true },
    );
  };

  for (const toggle of sectionToggles) {
    const contentId = toggle.getAttribute('aria-controls');
    const content = contentId ? document.getElementById(contentId) : null;
    const fallback = toggle.parentElement?.querySelector<HTMLElement>(
      '.recipe-section-title-fallback',
    );
    if (!content || !article) continue;

    toggle.hidden = false;
    fallback?.setAttribute('hidden', '');
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !expanded;
      toggle.setAttribute('aria-expanded', String(nextExpanded));
      animateSection(content, nextExpanded);
    });
  }

  const baseServings = Number(article?.dataset.baseServings);
  const servingsOutput = article?.querySelector<HTMLElement>('[data-servings-output]');
  const servingsButtons = Array.from(
    article?.querySelectorAll<HTMLButtonElement>('[data-servings-delta]') ?? [],
  );
  const ingredientRows = Array.from(
    article?.querySelectorAll<HTMLElement>('.ingredient[data-base-amount][data-unit]') ?? [],
  );

  const isIngredientUnit = (value: string | undefined): value is IngredientUnit =>
    ingredientUnits.some((unit) => unit === value);

  const isHouseholdUnit = (value: string | undefined): value is HouseholdUnit =>
    householdUnits.some((unit) => unit === value);

  const isMeasureDisplay = (value: string | undefined): value is MeasureDisplay =>
    measureDisplays.some((display) => display === value);

  if (
    Number.isInteger(baseServings)
    && baseServings > 0
    && servingsOutput
    && servingsButtons.length === 2
  ) {
    let servings = baseServings;
    for (const button of servingsButtons) button.hidden = false;

    const renderServings = () => {
      servingsOutput.textContent = String(servings);

      for (const button of servingsButtons) {
        const delta = Number(button.dataset.servingsDelta);
        button.disabled = servings + delta < 1 || servings + delta > 12;
      }

      for (const row of ingredientRows) {
        const amount = Number(row.dataset.baseAmount);
        const unit = row.dataset.unit;
        const gramsPerCup = Number(row.dataset.gramsPerCup);
        const householdUnit = row.dataset.householdUnit;
        const householdMetricAmount = Number(row.dataset.householdMetricAmount);
        const measure = row.dataset.measure;
        if (!Number.isFinite(amount) || !isIngredientUnit(unit)) continue;

        const ingredient: IngredientMeasure = {
          name: '',
          amount: (amount * servings) / baseServings,
          unit,
          ...(Number.isFinite(gramsPerCup) ? { gramsPerCup } : {}),
          ...(
            isHouseholdUnit(householdUnit)
            && Number.isFinite(householdMetricAmount)
            && householdMetricAmount > 0
              ? { household: { unit: householdUnit, metricAmount: householdMetricAmount } }
              : {}
          ),
          ...(isMeasureDisplay(measure) ? { measure } : {}),
        };
        const output = row.querySelector<HTMLElement>('[data-ingredient-measure]');
        if (output) output.textContent = formatMeasure(ingredient);
      }
    };

    for (const button of servingsButtons) {
      button.addEventListener('click', () => {
        const delta = Number(button.dataset.servingsDelta);
        if (!Number.isFinite(delta)) return;
        servings = Math.max(1, Math.min(12, servings + delta));
        renderServings();
      });
    }

    renderServings();
  }

  const progress = article?.querySelector<HTMLElement>('[data-ingredient-progress]');
  const ingredientToggles = Array.from(
    article?.querySelectorAll<HTMLButtonElement>('[data-checkable-ingredient]') ?? [],
  );

  const progressText = progress?.querySelector<HTMLElement>('[data-ingredient-progress-text]');

  if (
    progress
    && progressText
    && ingredientToggles.length > 0
    && article?.dataset.progressTemplate
  ) {
    progress.hidden = false;
    const progressTemplate = article.dataset.progressTemplate;
    const progressComplete = article.dataset.progressComplete;
    const total = ingredientToggles.length;

    const updateProgress = () => {
      const checked = ingredientToggles.filter(
        (button) => button.getAttribute('aria-pressed') === 'true',
      ).length;
      const complete = checked === total;
      progress.style.setProperty('--ingredient-progress', String(checked / total));
      progress.classList.toggle('is-complete', complete);
      progressText.textContent = complete && progressComplete
        ? progressComplete
        : progressTemplate
          .replace('{checked}', String(checked))
          .replace('{total}', String(total));
    };

    for (const button of ingredientToggles) {
      button.hidden = false;
      button.parentElement?.querySelector<HTMLElement>('.ingredient__fallback')
        ?.setAttribute('hidden', '');
      button.addEventListener('click', () => {
        const checked = button.getAttribute('aria-pressed') === 'true';
        button.setAttribute('aria-pressed', String(!checked));
        button.classList.toggle('is-checked', !checked);
        button.setAttribute(
          'aria-label',
          (!checked ? button.dataset.uncheckLabel : button.dataset.checkLabel) ?? '',
        );
        updateProgress();
      });
    }

    updateProgress();
  }

  const assistantChoice = article?.querySelector<HTMLElement>('[data-assistant-choice]');
  const assistantToggle = article?.querySelector<HTMLElement>('.assistant-toggle');
  if (article && assistantChoice && assistantToggle) {
    article.dataset.view = 'unselected';
    assistantChoice.hidden = false;
    const options = Array.from(
      assistantToggle.querySelectorAll<HTMLButtonElement>('[data-view-target]'),
    );

    for (const option of options) {
      option.addEventListener('click', () => {
        const target = option.dataset.viewTarget;
        if (!target) return;
        article.dataset.view = target;
        for (const other of options) {
          const active = other === option;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-pressed', String(active));
        }
      });
    }
  }

  /* Ścieżka kroków. Stan półkroków jest wspólny z panelem „Zanim zaczniesz”,
     a karty etapów rozwijają się niezależnie: czytelnik może trzymać otwartych
     kilka naraz. Na wejściu rozwinięty jest sam etap najbliższy do zrobienia,
     a ścieżka dokłada kolejny po oznaczeniu etapu jako wykonanego. */
  const preparationToggles = Array.from(
    article?.querySelectorAll<HTMLButtonElement>('[data-preparation-toggle]') ?? [],
  );
  const completedPreparation = new Set<string>();
  const stepItems = Array.from(
    article?.querySelectorAll<HTMLElement>('[data-step-item]') ?? [],
  );
  const stepJourneys = Array.from(
    article?.querySelectorAll<HTMLElement>('[data-step-journey]') ?? [],
  );

  const journeyItems = (journey: HTMLElement) =>
    Array.from(journey.querySelectorAll<HTMLElement>('[data-step-item]'));
  const stepAction = (item: HTMLElement) =>
    item.querySelector<HTMLButtonElement>('[data-checkable-step]');
  const isStepChecked = (item: HTMLElement) =>
    stepAction(item)?.getAttribute('aria-pressed') === 'true';

  const renderStepItem = (item: HTMLElement) => {
    const action = stepAction(item);
    const checked = action?.getAttribute('aria-pressed') === 'true';
    item.classList.toggle('is-done', checked);

    const badge = item.querySelector<HTMLElement>('[data-step-badge]');
    if (badge) badge.textContent = checked ? '✓' : (item.dataset.stepNumber ?? '');

    const label = action?.querySelector<HTMLElement>('[data-step-action-label]');
    if (action && label) {
      label.textContent = (checked ? action.dataset.uncheckLabel : action.dataset.checkLabel) ?? '';
    }
  };

  const renderStepPreparationProgress = (item: HTMLElement) => {
    const progress = item.querySelector<HTMLElement>('[data-step-group-progress]');
    const progressText = progress?.querySelector<HTMLElement>('[data-step-group-progress-text]');
    const toggles = Array.from(
      item.querySelectorAll<HTMLButtonElement>('[data-preparation-toggle]'),
    );
    const template = article?.dataset.stepProgressTemplate;
    if (!progress || !progressText || !template || toggles.length === 0) return;

    const checked = toggles.filter(
      (button) => button.getAttribute('aria-pressed') === 'true',
    ).length;
    const complete = checked === toggles.length;
    progress.style.setProperty('--step-progress', String(checked / toggles.length));
    progress.classList.toggle('is-complete', complete);
    progressText.textContent = complete && article?.dataset.stepProgressComplete
      ? article.dataset.stepProgressComplete
      : template
        .replace('{checked}', String(checked))
        .replace('{total}', String(toggles.length));
  };

  const renderJourney = (journey: HTMLElement) => {
    const items = journeyItems(journey);
    if (items.length === 0) return;

    const completed = items.filter(isStepChecked).length;
    const currentIndex = items.findIndex((item) => !isStepChecked(item));
    for (const [index, item] of items.entries()) {
      item.classList.toggle('is-current', index === currentIndex);
    }

    const progress = journey.querySelector<HTMLElement>('[data-steps-progress]');
    const progressText = progress?.querySelector<HTMLElement>('[data-steps-progress-text]');
    const template = article?.dataset.stepsJourneyTemplate;
    if (progress && progressText && template) {
      progress.hidden = false;
      progress.style.setProperty('--steps-progress', String(completed / items.length));
      progressText.textContent = template
        .replace('{current}', String(currentIndex === -1 ? items.length : currentIndex + 1))
        .replace('{total}', String(items.length));
    }

    const mode = journey.dataset.stepJourney;
    const completion = mode
      ? journey.querySelector<HTMLElement>(`[data-step-list-completion="${mode}"]`)
      : null;
    if (completion) {
      const controls = Array.from(
        journey.querySelectorAll<HTMLButtonElement>(
          '[data-checkable-step], [data-preparation-toggle]',
        ),
      );
      completion.hidden = !(
        controls.length > 0
        && controls.every((button) => button.getAttribute('aria-pressed') === 'true')
      );
    }
  };

  const renderStepJourneys = () => {
    for (const journey of stepJourneys) renderJourney(journey);
  };

  const setStepOpen = (item: HTMLElement, open: boolean, animate: boolean) => {
    const head = item.querySelector<HTMLButtonElement>('[data-step-head]');
    const body = item.querySelector<HTMLElement>('[data-step-body]');
    if (!head || !body) return;

    head.setAttribute('aria-expanded', String(open));
    item.classList.toggle('is-open', open);

    if (animate) {
      animateSection(body, open);
      return;
    }

    for (const animation of body.getAnimations()) animation.cancel();
    body.classList.remove('is-animating');
    body.style.height = '';
    body.style.paddingTop = '';
    body.hidden = !open;
  };

  /* Rozwinięcie etapu nie domyka pozostałych — ścieżka tylko dokłada kartę do
     już otwartych i pomija tę, którą czytelnik zdążył rozwinąć sam. */
  const openStepItem = (item: HTMLElement, animate: boolean) => {
    const head = item.querySelector<HTMLButtonElement>('[data-step-head]');
    if (head?.getAttribute('aria-expanded') === 'true') return;
    setStepOpen(item, true, animate);
  };

  const renderPreparation = (preparationId: string) => {
    const checked = completedPreparation.has(preparationId);

    for (const button of preparationToggles) {
      if (button.dataset.preparationId !== preparationId) continue;
      button.setAttribute('aria-pressed', String(checked));
      button.classList.toggle('is-checked', checked);
      button.setAttribute(
        'aria-label',
        (checked ? button.dataset.uncheckLabel : button.dataset.checkLabel) ?? '',
      );

      const item = button.closest<HTMLElement>('[data-step-item]');
      if (item) renderStepPreparationProgress(item);
    }

    renderStepJourneys();
  };

  /* Etap gotowania domyka też przypisane do niego półkroki — i tylko je. */
  const setStepChecked = (item: HTMLElement, checked: boolean) => {
    const action = stepAction(item);
    if (!action) return;

    action.setAttribute('aria-pressed', String(checked));
    for (const toggle of item.querySelectorAll<HTMLButtonElement>('[data-preparation-toggle]')) {
      const preparationId = toggle.dataset.preparationId;
      if (!preparationId) continue;

      if (checked) completedPreparation.add(preparationId);
      else completedPreparation.delete(preparationId);
      renderPreparation(preparationId);
    }

    renderStepItem(item);
    renderStepPreparationProgress(item);
    renderStepJourneys();
  };

  for (const button of preparationToggles) {
    button.hidden = false;
    button.parentElement?.querySelector<HTMLElement>('.prep-list__fallback')
      ?.setAttribute('hidden', '');

    const preparationId = button.dataset.preparationId;
    if (!preparationId) continue;
    button.addEventListener('click', () => {
      if (completedPreparation.has(preparationId)) completedPreparation.delete(preparationId);
      else completedPreparation.add(preparationId);
      renderPreparation(preparationId);
    });
  }

  for (const item of stepItems) {
    const journey = item.closest<HTMLElement>('[data-step-journey]');
    const head = item.querySelector<HTMLButtonElement>('[data-step-head]');
    const action = stepAction(item);
    const preparationBlock = item.querySelector<HTMLElement>('[data-step-prep]');
    const finalLabel = item.querySelector<HTMLElement>('[data-step-final-label]');

    if (head) head.hidden = false;
    item.querySelector<HTMLElement>('.step-item__heading-fallback')
      ?.setAttribute('hidden', '');
    if (action) action.hidden = false;
    if (preparationBlock) preparationBlock.hidden = false;
    if (finalLabel) finalLabel.hidden = false;

    head?.addEventListener('click', () => {
      if (head.getAttribute('aria-expanded') === 'true') setStepOpen(item, false, true);
      else openStepItem(item, true);
    });

    /* Po oznaczeniu etapu ścieżka prowadzi dalej sama: karta zwija się do
       jednoliniowej zapowiedzi, a rozwija się pierwszy etap wciąż do zrobienia.
       Pozostałe otwarte karty zostają otwarte. Cofnięcie zostawia kartę
       rozwiniętą, więc ruchu nie ma. */
    action?.addEventListener('click', () => {
      const checked = !isStepChecked(item);
      setStepChecked(item, checked);
      if (!journey || !checked) return;

      setStepOpen(item, false, true);
      const next = journeyItems(journey).find((candidate) => !isStepChecked(candidate));
      if (next) openStepItem(next, true);
    });

    renderStepItem(item);
    renderStepPreparationProgress(item);
  }

  for (const journey of stepJourneys) {
    const items = journeyItems(journey);
    const current = items.find((item) => !isStepChecked(item)) ?? null;
    for (const item of items) setStepOpen(item, item === current, false);
  }
  renderStepJourneys();

  for (const image of Array.from(
    article?.querySelectorAll<HTMLImageElement>('.recipe-hero__image') ?? [],
  )) {
    image.addEventListener('error', () => {
      image.hidden = true;
    });
  }
</script>
